# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ==============================================================================
# Firebase Admin SDK Configuration
# ==============================================================================
# Method 1 (Recommended for local dev):
# Place serviceAccountKey.json in server/config/ (automatically excluded from git)
#
# Method 2 (Recommended for Render / Cloud PaaS):
# Set FIREBASE_SERVICE_ACCOUNT_KEY with the full JSON string or Base64-encoded string:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
#
# Method 3 (Standard Env Variables):
FIREBASE_PROJECT_ID=aicheck-784df
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@aicheck-784df.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# AI Model Provider (Hugging Face)
# ==============================================================================
# If empty, AICheck automatically utilizes its built-in statistical & linguistic classifier
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL_URL=https://router.huggingface.co/hf-inference/models/roberta-base-openai-detector

# ==============================================================================
# Security & Upload Configuration
# ==============================================================================
MAX_FILE_SIZE_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
