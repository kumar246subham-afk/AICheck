# ==============================================================================
# AICheck Frontend Client Environment Variables (.env.example)
# ==============================================================================
# In local development, copy this file to client/.env and fill in your values.
# In production on Vercel, configure these exact variables in:
# Vercel Project Settings -> Environment Variables (Production, Preview, Development)
# ==============================================================================

# Public Firebase Web App Configuration (Firebase Console -> Project Settings -> General -> Web App)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Backend API URL (leave empty in development to use Vite proxy /api, or set to Render URL in production)
VITE_API_URL=https://your-backend.onrender.com
